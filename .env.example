# Public site URL, used for Open Graph links and share links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 5) — public anon key is safe in the browser; RLS protects data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by /api/account/delete. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (Phase 5) — cookieless mode
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
